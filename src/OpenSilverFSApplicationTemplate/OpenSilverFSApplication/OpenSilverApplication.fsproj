<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$ext_targetframework$</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <DefineSilverlight>true</DefineSilverlight>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenSilver" Version="$ext_opensilverpackageversion$" />$ext_themesnugetpackage$
  </ItemGroup>

  <ItemGroup>
    <Page Include="$ext_mainviewname$.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Compile Include="$ext_mainviewname$.xaml.fs">
      <DependentUpon>$ext_mainviewname$.xaml</DependentUpon>
    </Compile>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
    </ApplicationDefinition>
    <Compile Include="App.xaml.fs">
      <DependentUpon>App.xaml</DependentUpon>
    </Compile>
  </ItemGroup>
  
</Project>
