{
  "$schema": "http://json.schemastore.org/template",
  "author": "Userware",
  "classifications": [ "Web", "Desktop", "OpenSilver", "Xaml", "C#", "OpenRia" ],
  "identity": "OpensilverBusinessApplicationCS",
  "groupIdentity": "OpenSilverBusinessApplication",
  "name": "OpenSilver Business (Ria Services) Application",
  "shortName": "opensilverbusinessapp",
  "sourceName": "OpenSilverBusinessApplication",
  "description": "A template for creating a C# OpenSilver business application. OpenSilver is a modern cross-platform reimplementation of WPF and Silverlight that enables .NET developers to build apps for web (WebAssembly), mobile and desktop (MAUI Hybrid) using C# and XAML.",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "constraints": {
    "sdk-only": {
      "type": "host",
      "args": [
        {
          "hostname": "dotnetcli",
          "version": "[7.0,)"
        }
      ]
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(isWpf)",
          "exclude": [
            "OpenSilverBusinessApplication/MainPage.xaml",
            "OpenSilverBusinessApplication/MainPage.xaml.*"
          ]
        },
        {
          "condition": "(!isWpf)",
          "exclude": [
            "OpenSilverBusinessApplication/MainWindow.xaml",
            "OpenSilverBusinessApplication/MainWindow.xaml.*"
          ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    { "path": "./OpenSilverBusinessApplication/OpenSilverBusinessApplication.csproj" },
    { "path": "./OpenSilverBusinessApplication.Browser/OpenSilverBusinessApplication.Browser.csproj" },
    { "path": "./OpenSilverBusinessApplication.Simulator/OpenSilverBusinessApplication.Simulator.csproj" },
    { "path": "./OpenSilverBusinessApplication.Web/OpenSilverBusinessApplication.Web.csproj" }
  ],
  "symbols": {
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "description": "If specified, skips the automatic restore of the project on create.",
      "defaultValue": "false"
    },
    "targetFramework": {
      "type": "parameter",
      "datatype": "string",
      "description": "Sets the target .NET framework, must be net10.0 or net11.0",
      "defaultValue": "net11.0",
      "replaces": "net10.0",
      "choices": [
        {
          "choice": "net10.0",
          "description": "Use .NET 10.0"
        },
        {
          "choice": "net11.0",
          "description": "Use .NET 11.0"
        }
      ]
    },
    "templateKind": {
      "type": "parameter",
      "datatype": "choice",
      "description": "Specifies the style of the initial files generated for the application project.",
      "defaultValue": "wpf",
      "choices": [
        {
          "choice": "wpf",
          "description": "WPF-Style: MainWindow with Application.StartupUri"
        },
        {
          "choice": "silverlight",
          "description": "Silverlight-Style: MainPage with Application.RootVisual"
        }
      ]
    },
    "isWpf": {
      "type": "computed",
      "value": "(templateKind == \"wpf\")"
    },
    "mainViewName": {
      "type": "generated",
      "generator": "switch",
      "datatype": "string",
      "replaces": "$MainViewName$",
      "parameters": {
        "evaluator": "C++",
        "cases": [
          {
            "condition": "(isWpf)",
            "value": "MainWindow"
          },
          {
            "condition": "(!isWpf)",
            "value": "MainPage"
          }
        ]
      }
    },
    "startupUri": {
      "type": "generated",
      "generator": "switch",
      "datatype": "string",
      "replaces": "$StartupUri$",
      "parameters": {
        "evaluator": "C++",
        "cases": [
          {
            "condition": "(isWpf)",
            "value": "\r\n             StartupUri=\"MainWindow.xaml\""
          },
          {
            "condition": "(!isWpf)",
            "value": ""
          }
        ]
      }
    },
    "openSilverPackageVersion": {
      "type": "generated",
      "generator": "constant",
      "replaces": "$OpenSilverPackageVersion$",
      "parameters": {
        "value": "3.4.0-preview-2026-11-26-113522-38977eab"
      }
    },
    "openSilverSimulatorPackageVersion": {
      "type": "generated",
      "generator": "constant",
      "replaces": "$OpenSilverSimulatorPackageVersion$",
      "parameters": {
        "value": "3.4.0-preview-2026-11-26-113522-38977eab"
      }
    },
    "openSilverWebAssemblyPackageVersion": {
      "type": "generated",
      "generator": "constant",
      "replaces": "$OpenSilverWebAssemblyPackageVersion$",
      "parameters": {
        "value": "3.4.0-preview-2026-11-26-113522-38977eab"
      }
    },
    "openSilverOpenRiaPackageVersion": {
      "type": "generated",
      "generator": "constant",
      "replaces": "$OpenSilverOpenRiaPackageVersion$",
      "parameters": {
        "value": "3.4.0-preview-2026-11-24-183109-fd3c1ae"
      }
    },
    "webAssemblyPackageVersion": {
      "type": "generated",
      "generator": "switch",
      "datatype": "string",
      "replaces": "$WebAssemblyPackageVersion$",
      "parameters": {
        "evaluator": "C++",
        "cases": [
          {
            "condition": "(targetFramework == 'net10.0')",
            "value": "10.0.0"
          },
          {
            "condition": "(targetFramework == 'net11.0')",
            "value": "11.0.0"
          }
        ]
      }
    }
  },
  "postActions": [
    {
      "condition": "(!skipRestore)",
      "description": "Restore NuGet packages required by the OpenSilver projects.",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    },
    {
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "condition": "(OS == \"Windows_NT\" && !skipRestore)",
      "args": {
        "executable": "msbuild-restore.bat",
        "args": "",
        "redirectStandardOutput": false,
        "redirectStandardError": false
      },
      "manualInstructions": [
        {
          "text": "Run 'msbuild-restore.bat'"
        }
      ],
      "continueOnError": true,
      "description ": "setups the project by calling msbuild-restore.bat"
    }
  ]
}