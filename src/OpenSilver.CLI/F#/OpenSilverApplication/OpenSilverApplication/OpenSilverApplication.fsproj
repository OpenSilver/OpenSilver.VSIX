<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <DefineSilverlight>true</DefineSilverlight>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenSilver" Version="$OpenSilverPackageVersion$" />
    <!--#if(theme == 'modern-light' || theme == 'modern-dark')-->
    <PackageReference Include="OpenSilver.Themes.Modern" Version="$ModernThemePackageVersion$" />
    <!--#endif-->
    <!--#if(theme == 'wpf')-->
    <PackageReference Include="OpenSilver.Themes.Wpf" Version="$WpfThemePackageVersion$" />
    <!--#endif-->
  </ItemGroup>

  <!-- Declared here (and not only by OpenSilver.targets) so that Visual Studio knows these item types before the
       NuGet restore. Otherwise the F# project tree fails to refresh after the restore (ProjectTreeCorruptionException). -->
  <ItemGroup>
    <AvailableItemName Include="ApplicationDefinition" />
    <AvailableItemName Include="Page" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="$MainViewName$.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Compile Include="$MainViewName$.xaml.fs">
      <DependentUpon>$MainViewName$.xaml</DependentUpon>
    </Compile>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
    </ApplicationDefinition>
    <Compile Include="App.xaml.fs">
      <DependentUpon>App.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
